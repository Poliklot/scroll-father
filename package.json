{
	"name": "scroll-father",
	"version": "2.4.1",
	"description": "Scroll Father: A library for scroll events and dynamic class handling.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./ScrollFather.min.js": "./dist/ScrollFather.min.js"
	},
	"unpkg": "./dist/ScrollFather.min.js",
	"jsdelivr": "./dist/ScrollFather.min.js",
	"scripts": {
		"build": "rollup -c",
		"smoke": "node scripts/smoke-test.js",
		"ssr": "node scripts/ssr-test.js",
		"size:check": "node scripts/bundle-size-check.js",
		"pack:check": "node scripts/pack-check.js",
		"test": "npm run build && npm run smoke && npm run ssr && npm run size:check && npm run pack:check",
		"watch": "rollup -c -w",
		"release": "node scripts/release.js",
		"demos": "BUILD_TARGET=demos npm run build && concurrently --kill-others \"vite\" \"npm run watch\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/poliklot/scroll-father.git"
	},
	"keywords": [
		"scroll",
		"events",
		"javascript",
		"typescript",
		"library"
	],
	"author": "Poliklot",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/poliklot/scroll-father/issues"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"devDependencies": {
		"@babel/preset-env": "^7.26.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"chalk": "^5.3.0",
		"concurrently": "^9.1.0",
		"fs-extra": "^11.2.0",
		"inquirer": "^12.1.0",
		"ora": "^8.1.1",
		"postcss-preset-env": "^10.0.8",
		"prettier-plugin-jsdoc": "^1.3.0",
		"rollup": "^4.62.3",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-dts": "^6.4.1",
		"sass-embedded": "^1.80.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.1.5"
	},
	"overrides": {
		"minimatch": "10.2.6"
	}
}
